# ==========================
# Techspire Official
# SAFE DEFAULT CONFIGURATION
# ==========================
# Copy this file to .env and fill in what you need. Never commit .env.
# Empty values fall back to the defaults shown in the comments.

# --- AI ------------------------------------------------------------------
# gemini (default) or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Empty = provider default: gemini-3.5-flash-lite (Gemini) / gpt-6-luna (OpenAI).
# gemini-3.8-flash writes richer copy but its FREE tier allows only 20 requests per day.
AI_MODEL=
# none | low | medium | high  (Gemini thinking level / OpenAI reasoning effort). Empty = provider default.
AI_REASONING_EFFORT=low
# Optional, OpenAI only. Current Gemini models do not accept temperature.
AI_TEMPERATURE=
AI_REQUEST_TIMEOUT=60

# --- Facebook (future live publishing only) -------------------------------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Empty = v26.0 (latest Graph API version as of 2026-09-28)
FB_GRAPH_API_VERSION=

# --- HARD SAFETY LOCKS ------------------------------------------------------
# Live publishing needs DRY_RUN=false AND PUBLISH_ENABLED=true AND the --publish flag.
# Keep these values until you have made a deliberate decision to go live.
DRY_RUN=true
PUBLISH_ENABLED=false
# Even when publishing is enabled, --publish must name the reviewed cards (--ids 12,15).
# Only set this to false if every fresh reviewed card should be posted automatically.
PUBLISH_REQUIRE_IDS=true

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=INFO
DATABASE_PATH=data/techspire.db
OUTPUT_DIR=output
LOG_DIR=logs
FEEDS_FILE=config/feeds.yaml
MAX_ARTICLES_PER_RUN=10
MAX_ARTICLE_AGE_HOURS=48
MAX_RETRIES_PER_ARTICLE=3

# --- Networking -------------------------------------------------------------
RSS_REQUEST_TIMEOUT=20
FACEBOOK_REQUEST_TIMEOUT=30
# Empty = TechspireNewsBot/1.0 (+https://www.facebook.com/techspireofficial)
RSS_USER_AGENT=

# --- Branding (optional) ------------------------------------------------------
# Bundled Montserrat fonts are used when these are empty.
FONT_HEADLINE_PATH=
FONT_BRAND_PATH=
FONT_LABEL_PATH=
# PNG with transparency, e.g. assets/brand/logo.png (drawn next to the wordmark)
BRAND_LOGO_PATH=
# Small text at the top right of every card (empty = BITESIZE NEWS)
CARD_TAGLINE=
